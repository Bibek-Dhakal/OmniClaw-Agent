# General
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8080
OWNER_NAME=Owner
MEMORY_USER_ID=owner
MAX_AGENT_STEPS=12
HISTORY_TURNS=12
APPROVAL_REQUIRED=true
APPROVAL_TIMEOUT_SECONDS=300

# Agent engine: native | hermes | openclaw (all routed through LiteLLM)
AGENT_ENGINE=native
# Hosted example (Gemini): LLM_MODEL=gemini/gemini-3.8-flash and set LLM_API_KEY.
# Any OpenAI-compatible server: LLM_MODEL=openai/<model-name> or openai/auto, LLM_API_BASE=http://<host>:<port>/v1
# Inside Docker, "localhost" is the container itself. Use host.docker.internal for services
# running on your machine.
LLM_MODEL=gemini/gemini-3.8-flash
LLM_API_BASE=
LLM_API_KEY=your-llm-api-key
HERMES_MODEL=openai/hermes
HERMES_API_BASE=
HERMES_API_KEY=
OPENCLAW_MODEL=openai/openclaw
OPENCLAW_API_BASE=
OPENCLAW_API_KEY=

# Tool discovery
TOOL_ROUTE_TOP_K=8
TOOL_CACHE_TTL_SECONDS=3600

# Storage
DATABASE_URL=postgresql://omniclaw:change-me@localhost:5432/omniclaw
POSTGRES_PASSWORD=change-me
MEM0_API_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Connectors (set Composio, Nango, both, or neither)
COMPOSIO_API_KEY=
COMPOSIO_BASE_URL=https://backend.composio.dev
# MUST equal the user id shown on your ACTIVE connected accounts in the Composio dashboard.
# A mismatch gives "No connected account found for user ID ..." (HTTP 404).
COMPOSIO_USER_ID=default
NANGO_SECRET_KEY=
# Nango Cloud: https://api.nango.dev
# Nango self-hosted from Docker: http://host.docker.internal:<your Nango server port>
NANGO_BASE_URL=https://api.nango.dev
# Optional: preferred connection id when you have several for the same provider
NANGO_CONNECTION_ID=

# Telegram (comma-separated numeric user ids)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# WhatsApp Cloud API (comma-separated numbers, digits only, with country code)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ALLOWED_NUMBERS=
WHATSAPP_GRAPH_VERSION=v23.0

# Voice
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
VOICE_REPLIES_ALWAYS=false
STT_MODEL=whisper-1
STT_API_KEY=

# Browser automation
BROWSER_HEADLESS=true
BROWSER_STATE_DIR=./.browser_state
BROWSER_ALLOWED_DOMAINS=instagram.com,tinder.com,linkedin.com,github.com